    <style>
        :root {
            --ink: #07090f;
            --blue: #177DFE;
            --gold: #F5C842;
            --surface: #0f1420;
            --muted: #8892a4;
            --border: rgba(255,255,255,0.07);
        }
 
        * { box-sizing: border-box; }
 
        body {
            font-family: 'DM Sans', sans-serif;
            background: var(--ink);
            color: #e8ecf4;
            overflow-x: hidden;
        }
 
        h1, h2, h3, .syne { font-family: 'Syne', sans-serif; }
 
        /* ── NOISE TEXTURE OVERLAY ── */
        body::before {
            content: '';
            position: fixed;
            inset: 0;
            background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 200 200' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='n'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.9' numOctaves='4' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23n)' opacity='0.04'/%3E%3C/svg%3E");
            pointer-events: none;
            z-index: 0;
            opacity: 0.5;
        }
 
        /* ── GRID BACKGROUND ── */
        .grid-bg {
            background-image:
                linear-gradient(rgba(23,125,254,0.04) 1px, transparent 1px),
                linear-gradient(90deg, rgba(23,125,254,0.04) 1px, transparent 1px);
            background-size: 60px 60px;
        }
 
        /* ── GLOW BLOBS ── */
        .blob {
            position: absolute;
            border-radius: 50%;
            filter: blur(120px);
            pointer-events: none;
        }
 
        /* ── HEADER ── */
        header {
            position: fixed;
            top: 0; left: 0; right: 0;
            z-index: 50;
            padding: 18px 0;
            border-bottom: 1px solid var(--border);
            background: rgba(7,9,15,0.8);
            backdrop-filter: blur(20px);
            -webkit-backdrop-filter: blur(20px);
        }
 
        /* ── BADGE ── */
        .badge {
            display: inline-flex;
            align-items: center;
            gap: 6px;
            padding: 5px 12px;
            border-radius: 999px;
            font-size: 11px;
            font-weight: 600;
            letter-spacing: 0.08em;
            text-transform: uppercase;
        }
 
        /* ── BUTTONS ── */
        .btn-primary {
            display: inline-flex;
            align-items: center;
            gap: 8px;
            background: var(--blue);
            color: white;
            font-family: 'Syne', sans-serif;
            font-weight: 700;
            font-size: 15px;
            padding: 14px 28px;
            border-radius: 12px;
            border: none;
            cursor: pointer;
            transition: all 0.2s;
            position: relative;
            overflow: hidden;
            text-decoration: none;
        }
        .btn-primary::after {
            content: '';
            position: absolute;
            inset: 0;
            background: linear-gradient(135deg, rgba(255,255,255,0.15), transparent);
            pointer-events: none;
        }
        .btn-primary:hover { transform: translateY(-2px); box-shadow: 0 12px 40px rgba(23,125,254,0.4); }
 
        .btn-ghost {
            display: inline-flex;
            align-items: center;
            gap: 8px;
            background: transparent;
            color: #e8ecf4;
            font-family: 'DM Sans', sans-serif;
            font-weight: 600;
            font-size: 15px;
            padding: 13px 28px;
            border-radius: 12px;
            border: 1px solid var(--border);
            cursor: pointer;
            transition: all 0.2s;
            text-decoration: none;
        }
        .btn-ghost:hover { border-color: rgba(255,255,255,0.25); background: rgba(255,255,255,0.04); }
 
        .btn-gold {
            display: inline-flex;
            align-items: center;
            gap: 8px;
            background: var(--gold);
            color: #07090f;
            font-family: 'Syne', sans-serif;
            font-weight: 800;
            font-size: 15px;
            padding: 14px 32px;
            border-radius: 12px;
            border: none;
            cursor: pointer;
            transition: all 0.2s;
            text-decoration: none;
        }
        .btn-gold:hover { transform: translateY(-2px); box-shadow: 0 12px 40px rgba(245,200,66,0.35); }
 
        /* ── CARDS ── */
        .card {
            background: var(--surface);
            border: 1px solid var(--border);
            border-radius: 20px;
            transition: all 0.3s;
        }
        .card:hover { border-color: rgba(23,125,254,0.3); transform: translateY(-4px); }
 
        /* ── HERO PRODUCT CARD ── */
        .product-card {
            background: var(--surface);
            border: 1px solid var(--border);
            border-radius: 20px;
            padding: 20px;
            transform: rotate(2deg);
            box-shadow: 0 40px 80px rgba(0,0,0,0.5);
            transition: transform 0.4s;
        }
        .product-card:hover { transform: rotate(0deg) scale(1.02); }
 
        /* ── TICKER ── */
        .ticker-wrap { overflow: hidden; }
        .ticker {
            display: flex;
            gap: 48px;
            width: max-content;
            animation: ticker 20s linear infinite;
            white-space: nowrap;
        }
        @keyframes ticker { from { transform: translateX(0); } to { transform: translateX(-50%); } }
 
        /* ── STEP NUMBER ── */
        .step-num {
            width: 48px; height: 48px;
            background: rgba(23,125,254,0.12);
            border: 1px solid rgba(23,125,254,0.3);
            border-radius: 12px;
            display: flex; align-items: center; justify-content: center;
            font-family: 'Syne', sans-serif;
            font-weight: 800;
            font-size: 20px;
            color: var(--blue);
            flex-shrink: 0;
        }
 
        /* ── CATEGORY PILL ── */
        .cat-card {
            background: var(--surface);
            border: 1px solid var(--border);
            border-radius: 16px;
            padding: 24px 20px;
            display: flex;
            align-items: center;
            gap: 16px;
            transition: all 0.25s;
            cursor: default;
        }
        .cat-card:hover { border-color: rgba(23,125,254,0.4); background: rgba(23,125,254,0.05); transform: translateX(4px); }
        .cat-card.gold { border-color: rgba(245,200,66,0.4); }
        .cat-card.gold:hover { background: rgba(245,200,66,0.05); border-color: var(--gold); }
 
        /* ── COUNTER ── */
        .stat-num {
            font-family: 'Syne', sans-serif;
            font-weight: 800;
            font-size: 36px;
            color: white;
            line-height: 1;
        }
 
        /* ── MODAL ── */
        .modal-backdrop {
            position: fixed; inset: 0;
            background: rgba(0,0,0,0.75);
            backdrop-filter: blur(8px);
            display: flex; align-items: center; justify-content: center;
            z-index: 100;
            opacity: 0; visibility: hidden;
            transition: all 0.3s;
        }
        .modal-visible { opacity: 1; visibility: visible; }
        .modal-box {
            background: #0f1420;
            border: 1px solid var(--border);
            border-radius: 24px;
            padding: 2rem;
            width: 92%;
            max-width: 560px;
            max-height: 85vh;
            overflow-y: auto;
            transform: translateY(20px);
            transition: transform 0.3s;
        }
        .modal-visible .modal-box { transform: translateY(0); }
 
        /* ── ANIMATIONS ── */
        .fade-up {
            opacity: 0;
            transform: translateY(28px);
            animation: fadeUp 0.7s ease forwards;
        }
        @keyframes fadeUp { to { opacity: 1; transform: translateY(0); } }
        .delay-1 { animation-delay: 0.1s; }
        .delay-2 { animation-delay: 0.22s; }
        .delay-3 { animation-delay: 0.36s; }
        .delay-4 { animation-delay: 0.5s; }
 
        /* ── SECTION LABEL ── */
        .section-label {
            font-size: 11px;
            font-weight: 600;
            letter-spacing: 0.14em;
            text-transform: uppercase;
            color: var(--blue);
        }
 
        /* scrollbar */
        ::-webkit-scrollbar { width: 6px; }
        ::-webkit-scrollbar-track { background: var(--ink); }
        ::-webkit-scrollbar-thumb { background: #2a3040; border-radius: 3px; }
 
 
        /* ══ MOBILE FIXES ══ */
        @media (max-width: 640px) {
            /* Prevent ANY horizontal overflow */
            html, body { overflow-x: hidden; max-width: 100vw; }
 
            /* Blobs — shrink so they don't cause scroll */
            .blob { display: none; }
 
            /* Header nav — tighter padding */
            header nav { padding: 0 16px; }
 
            /* Hero */
            section.grid-bg { padding-top: 90px; padding-bottom: 48px; min-height: auto; }
 
            /* Hero heading — smaller on mobile */
            h1.syne { font-size: 2.6rem !important; line-height: 1.08 !important; }
 
            /* Hero product card — no rotation, full width */
            .product-card { transform: none !important; max-width: 100% !important; width: 100% !important; }
            .product-card:hover { transform: none !important; }
 
            /* Buttons — full width on mobile */
            .btn-gold, .btn-ghost, .btn-primary { width: 100%; justify-content: center; }
 
            /* Section headings */
            .syne.text-4xl { font-size: 1.9rem !important; }
            .syne.text-5xl { font-size: 2.1rem !important; }
 
            /* Section padding */
            section[style*="padding:100px"] { padding: 60px 0 !important; }
            section[style*="padding:80px"]  { padding: 48px 0 !important; }
 
            /* Features grid gap */
            .grid.gap-5 { gap: 12px; }
 
            /* Category cards — horizontal layout can stack text */
            .cat-card { padding: 18px 14px; }
 
            /* How it works steps */
            .step-num { width: 40px; height: 40px; font-size: 16px; }
 
            /* Footer columns — stack cleanly */
            footer .grid { grid-template-columns: 1fr 1fr; gap: 24px 16px; }
 
            /* CTA section */
            #join h2 { font-size: 2rem !important; }
            #join { padding: 60px 0 !important; }
 
            /* Modal */
            .modal-box { padding: 1.25rem; width: 96%; }
 
            /* Ticker — slightly smaller text */
            .ticker span { font-size: 11px !important; }
 
            /* Social proof line — allow wrapping */
            .text-sm.text-gray-500 { white-space: normal; line-height: 1.8; }
 
            /* Gap in hero grid */
            .gap-16 { gap: 40px; }
 
            /* px-5 fine, but ensure no bleed */
            .max-w-7xl { padding-left: 16px !important; padding-right: 16px !important; }
        }
 
        @media (max-width: 380px) {
            h1.syne { font-size: 2.1rem !important; }
            .btn-gold, .btn-ghost { font-size: 14px; padding: 12px 20px; }
        }
 
    </style>
</head>
